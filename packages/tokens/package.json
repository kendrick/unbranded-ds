{
	"author": "Kendrick Arnett",
	"bugs": "https://github.com/kendrick/unbranded-ds/issues",
	"dependencies": {
		"zod": "^3"
	},
	"description": "Design tokens for the unbranded-ds design system: DTCG-format JSON sources compiled via Style Dictionary to CSS variables, a Tailwind v4 @theme preset, JSON, and a typed TypeScript token map.",
	"devDependencies": {
		"style-dictionary": "^4",
		"tsx": "^4.21.0",
		"typescript": "^5",
		"vitest": "^3"
	},
	"exports": {
		".": {
			"import": "./dist/ts/index.js",
			"types": "./dist/ts/index.d.ts"
		},
		"./dist/json/*": "./dist/json/*",
		"./preset.css": "./dist/tailwind/preset.css",
		"./runtime": {
			"import": "./dist/ts/runtime.js",
			"types": "./dist/ts/runtime.d.ts"
		}
	},
	"files": [
		"dist",
		"themes"
	],
	"homepage": "https://github.com/kendrick/unbranded-ds#readme",
	"keywords": [
		"design-tokens",
		"design-system",
		"dtcg",
		"style-dictionary",
		"tailwind",
		"css-variables"
	],
	"license": "MIT",
	"main": "./dist/ts/index.js",
	"name": "@unbranded-ds/tokens",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/tokens",
		"type": "git",
		"url": "git+https://github.com/kendrick/unbranded-ds.git"
	},
	"scripts": {
		"build": "tsx sd.config.ts && tsc -p tsconfig.build.json",
		"lint": "eslint src/",
		"test": "vitest run",
		"test:unit": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"types": "./dist/ts/index.d.ts",
	"version": "0.2.0"
}
