{
	"name": "@unbranded-ds/react",
	"type": "module",
	"version": "0.5.0",
	"description": "React component primitives for the unbranded-ds design system: Base UI + shadcn-style components styled with the @unbranded-ds/tokens Tailwind v4 preset.",
	"author": "Kendrick Arnett",
	"license": "MIT",
	"homepage": "https://github.com/kendrick/unbranded-ds#readme",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"directory": "packages/react",
		"type": "git",
		"url": "git+https://github.com/kendrick/unbranded-ds.git"
	},
	"bugs": "https://github.com/kendrick/unbranded-ds/issues",
	"keywords": [
		"design-system",
		"react",
		"components",
		"base-ui",
		"shadcn",
		"tailwind",
		"unbranded-ds"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./preset.css": "./dist/preset.css"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"lint": "eslint src/",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@base-ui-components/react": "^1.0.0-rc.0",
		"react": "^18 || ^19",
		"react-dom": "^18 || ^19"
	},
	"dependencies": {
		"@unbranded-ds/tokens": "workspace:*",
		"class-variance-authority": "^0.7",
		"clsx": "^2",
		"lucide-react": "^1.8.0",
		"tailwind-merge": "^3"
	},
	"devDependencies": {
		"@base-ui-components/react": "^1.0.0-rc.0",
		"@storybook/react-vite": "^10.3",
		"@testing-library/jest-dom": "^6",
		"@testing-library/react": "^16",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^25",
		"react": "^19",
		"react-dom": "^19",
		"shadcn": "^4.2.0",
		"storybook": "^10.3",
		"tailwindcss": "^4",
		"tsup": "^8",
		"typescript": "^5",
		"vite": "^6",
		"vitest": "^3"
	}
}
