  },
  "devDependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@testing-library/react": "^16",
    "@testing-library/jest-dom": "^6",
    "jsdom": "^25",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3",
    "tailwindcss": "^4"
  }
